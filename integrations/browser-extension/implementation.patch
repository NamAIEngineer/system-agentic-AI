--- /dev/null
+++ b/shared/protocol.mjs
@@ -0,0 +1,18 @@
+export const operations = new Set(['capabilities', 'observe', 'read_state', 'act', 'handoff']);
+export function validate(request) {
+  if (!request || request.version !== 1 || !operations.has(request.op) ||
+      typeof request.id !== 'string' || ['__proto__','constructor','prototype'].includes(request.id) || !/^[a-zA-Z0-9_-]{1,100}$/.test(request.id))
+    throw new Error('INVALID_REQUEST');
+  if (request.op === 'act' && (!['click', 'fill'].includes(request.action) ||
+      typeof request.ref !== 'string' || typeof request.lease !== 'string' ||
+      typeof request.pageId !== 'string' || !Number.isSafeInteger(request.epoch) ||
+      (request.action === 'fill' && (typeof request.text !== 'string' || request.text.length > 10000))))
+    throw new Error('INVALID_ACTION');
+  return request;
+}
+export const capabilities = {
+  engine: 'chromium', tier: 1, operations: [...operations], actions: ['click', 'fill'],
+  profiles: ['github', 'notion', 'generic'], trustedInput: true,
+  crossOriginFrames: false, firefox: 'UNAVAILABLE', safari: 'UNAVAILABLE',
+  arbitraryEvaluation: false, modelProvider: null,
+};
