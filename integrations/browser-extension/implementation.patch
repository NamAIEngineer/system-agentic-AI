+// Dedicated local browser demonstration. Never imports a personal browser profile.
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import {createRequire} from 'node:module';
+const [workbench,connectionFile]=process.argv.slice(2);
+if(!workbench || !connectionFile) throw Error('usage: open-browser.mjs SYSTEM_AGENTIC_ROOT CONNECTION_FILE');
+const config=JSON.parse(fs.readFileSync(connectionFile));
+const root=path.resolve(new URL('..',import.meta.url).pathname);
+const require=createRequire(path.join(process.env.SYSTEM_AGENTIC_PLAYWRIGHT_PROJECT || path.join(workbench,'design-os-system-one/projects/voice-browser-agent'),'package.json'));
+const {chromium}=require('playwright');
+const profile=path.join(path.dirname(connectionFile),'../chromium-profile');
+fs.mkdirSync(profile,{recursive:true,mode:0o700});fs.chmodSync(profile,0o700);
+const context=await chromium.launchPersistentContext(profile,{headless:false,
+ executablePath:(process.env.CHROMIUM_EXECUTABLE_PATH || path.join(os.homedir(),'Library/Caches/ms-playwright/chromium-1248/chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing')),
+ args:[`--disable-extensions-except=${root}/dist`,`--load-extension=${root}/dist`]});
+const pidFile=path.join(path.dirname(connectionFile),'browser.pid');
+fs.writeFileSync(pidFile,String(process.pid),{mode:0o600});
+const page=context.pages()[0] || await context.newPage();
+const target='https://github.com/jangtrinh/design-os-browser-extension';
+await page.goto(target,{waitUntil:'domcontentloaded',timeout:30000});
+const pair=await context.newPage();
+await pair.goto(`chrome-extension://${config.extensionId}/pair.html`);
+const options=await pair.locator('#tab option').evaluateAll(options=>options.map(o=>({value:o.value,label:o.textContent})));
+const selected=options.find(option=>option.label.includes('https://github.com'));
+if(selected) {
+ await pair.locator('#tab').selectOption(selected.value);
+ await pair.locator('#connection').setInputFiles(connectionFile);
+ await pair.waitForFunction(()=>document.getElementById('token').value.length===64);
+ await pair.getByRole('button',{name:'Pair selected tab',exact:true}).click();
+ await pair.locator('#result').filter({hasText:'PAIRED'}).waitFor();
+}
+await page.bringToFront();
+console.log(JSON.stringify({status:selected?'PAIRED':'USER_ACTION_REQUIRED',scope:'dedicated profile; public GitHub read demonstration',pid:process.pid,profile,pairedOrigin:selected?'https://github.com':null}));
+for(const signal of ['SIGINT','SIGTERM']) process.once(signal,()=>context.close());
+await context.waitForEvent('close',{timeout:0});
+if(fs.existsSync(pidFile) && fs.readFileSync(pidFile,'utf8')===String(process.pid)) fs.unlinkSync(pidFile);
diff --git a/tests/bridge.test.mjs b/tests/bridge.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/bridge.test.mjs
@@ -0,0 +1,40 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import WebSocket from 'ws';
+import {startBridge} from '../cli/bridge.mjs';
+const {id:extensionId}=JSON.parse(fs.readFileSync('shared/extension-id.json'));
+const wait=milliseconds=>new Promise(resolve=>setTimeout(resolve,milliseconds));
+test('trust boundary, timeout receipts, conflicts, restart and no replay',async()=> {
+  const directory=fs.mkdtempSync(path.join(os.tmpdir(),'agent-rpc-test-'));
+  let bridge=await startBridge({directory,extensionId,timeout:250});
+  await assert.rejects(()=>startBridge({directory,extensionId}),/EEXIST/);
+  const url=()=>`http://127.0.0.1:${bridge.config.port}`;
+  const post=(body,headers={})=>fetch(url()+'/rpc',{method:'POST',headers:{Authorization:`Bearer ${bridge.config.controllerToken}`,...headers},body:JSON.stringify(body)});
+  try {
+    assert.equal((await fetch(url()+'/health')).status,403);
+    assert.equal((await post({},{Origin:'https://evil.example'})).status,403);
+    const denied=new WebSocket(url().replace('http:','ws:')+'/extension',{origin:'https://evil.example'});
+    const deniedResult=await new Promise(resolve=>{denied.on('error',()=>resolve('denied'));denied.on('open',()=>resolve('opened'));});
+    assert.equal(deniedResult,'denied');
+    const ws=new WebSocket(url().replace('http:','ws:')+'/extension',{origin:`chrome-extension://${extensionId}`});
+    await new Promise(resolve=>ws.on('open',resolve));
+    ws.send(JSON.stringify({token:bridge.config.extensionToken}));
+    await new Promise(resolve=>ws.once('message',resolve));
+    let deliveries=0;
+    ws.on('message',message=> {const rpc=JSON.parse(message);if(rpc.op){deliveries++;assert.ok(rpc.deadline>Date.now());}});
+    const mutation={version:1,id:'uncertain',op:'act',action:'click',ref:'x',lease:'x',pageId:'x',epoch:1};
+    const first=await (await post(mutation)).json();assert.equal(first.status,'UNCERTAIN');
+    assert.deepEqual(await (await post(mutation)).json(),first);
+    assert.equal(deliveries,1);
+    assert.equal((await (await post({...mutation,ref:'other'})).json()).error,'REQUEST_ID_CONFLICT');
+    ws.send(JSON.stringify({id:'uncertain',status:'COMPLETED'}));await wait(20);
+    assert.deepEqual(await (await post(mutation)).json(),first);
+    ws.terminate();await bridge.close();
+    bridge=await startBridge({directory,extensionId,timeout:250});
+    assert.deepEqual(await (await post(mutation)).json(),first);
+    assert.equal(fs.statSync(path.join(directory,'connection.json')).mode & 0o777,0o600);
+  } finally {await bridge.close();fs.rmSync(directory,{recursive:true,force:true});}
+});
diff --git a/tests/browser.test.mjs b/tests/browser.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/browser.test.mjs
@@ -0,0 +1,145 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import http from 'node:http';
+import {execFile} from 'node:child_process';
+import {promisify} from 'node:util';
+import {createRequire} from 'node:module';
+import {startBridge} from '../cli/bridge.mjs';
+const workbench=process.env.SYSTEM_AGENTIC_ROOT || path.resolve('../..');
+const require=createRequire(`${process.env.SYSTEM_AGENTIC_PLAYWRIGHT_PROJECT || `${workbench}/design-os-system-one/projects/voice-browser-agent`}/package.json`);
+const {chromium}=require('playwright');
+const root=path.resolve('.');
+const {id:extensionId}=JSON.parse(fs.readFileSync('shared/extension-id.json'));
+const chromePath=(process.env.CHROMIUM_EXECUTABLE_PATH || path.join(os.homedir(),'Library/Caches/ms-playwright/chromium-1248/chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing'));
+
+test('real Chromium: pairing, three semantic workflows, fences and handoff',async t=> {
+  const directory=fs.mkdtempSync(path.join(os.tmpdir(),'agent-browser-test-'));
+  const bridge=await startBridge({directory:path.join(directory,'bridge'),extensionId,timeout:5000});
+  const fixture=http.createServer((req,res)=> {
+    res.setHeader('Content-Type','text/html');
+    const kind=req.url.slice(1);
+    res.end(`<!doctype html><title>${kind} fixture</title><h1>${kind==='auth'?'Sign in to continue':kind==='challenge'?'Verify you are human':kind==='payment'?'Checkout':kind}</h1>
+      ${kind==='notion'?'<div role="textbox" aria-label="Page content" contenteditable="true">Old content</div>':'<label>Title<input aria-label="Title" value="Old title"></label>'}
+      <button id="save"><span>Save</span></button><p id="status"></p><script>
+      const input=document.querySelector('input,[contenteditable]');
+      const saved=localStorage.getItem('${kind}');if(saved){if(input.tagName==='INPUT')input.value=saved;else input.textContent=saved;}
+      document.querySelector('#save').onclick=e=>{const text=input.value??input.textContent;localStorage.setItem('${kind}',text);document.querySelector('#status').textContent='Saved: '+text+' trusted='+e.isTrusted;};
+      </script>`);
+  });
+  await new Promise(resolve=>fixture.listen(0,'127.0.0.1',resolve));
+  const base=`http://127.0.0.1:${fixture.address().port}`;
+  const context=await chromium.launchPersistentContext(path.join(directory,'profile'),{executablePath:chromePath,headless:true,args:[`--disable-extensions-except=${root}/dist`,`--load-extension=${root}/dist`]});
+  t.after(async()=> {await context.close();await bridge.close();await new Promise(resolve=>fixture.close(resolve));fs.rmSync(directory,{recursive:true,force:true});});
+  const page=await context.newPage();await page.goto(`${base}/github`);
+  const pair=await context.newPage();await pair.goto(`chrome-extension://${extensionId}/pair.html`);
+  await pair.locator('#port').fill(String(bridge.config.port));
+  await pair.locator('#token').fill(bridge.config.extensionToken);
+  await pair.getByRole('button',{name:'Pair selected tab',exact:true}).click();
+  await assert.doesNotReject(()=>pair.locator('#result').filter({hasText:'PAIRED'}).waitFor());
+  let serial=0;
+  const rpc=async (op,extra={})=> {
+    const response=await fetch(`http://127.0.0.1:${bridge.config.port}/rpc`,{method:'POST',headers:{Authorization:`Bearer ${bridge.config.controllerToken}`,'Content-Type':'application/json'},body:JSON.stringify({version:1,id:`test-${++serial}`,op,...extra})});
+    return response.json();
+  };
+  for(const kind of ['github','notion','generic']) {
+    await page.goto(`${base}/${kind}`);
+    let observed=await rpc('observe');assert.equal(observed.status,'COMPLETED',JSON.stringify(observed));
+    const input=observed.elements.find(e=>e.role==='textbox');assert.ok(input,JSON.stringify(observed));
+    const action={ref:input.ref,lease:observed.lease,epoch:observed.epoch,pageId:observed.pageId,action:'fill',text:`Updated ${kind}`};
+    assert.equal((await rpc('act',action)).status,'COMPLETED');
+    observed=await rpc('observe');
+    const save=observed.elements.find(e=>e.name==='Save');
+    await page.evaluate(()=>{window.saveCount=0;document.querySelector('#save').addEventListener('click',()=>window.saveCount++);});
+    const requestId=`save-${kind}`;
+    const click={id:requestId,ref:save.ref,lease:observed.lease,epoch:observed.epoch,pageId:observed.pageId,action:'click'};
+    const result=await rpc('act',click);assert.equal(result.status,'COMPLETED',JSON.stringify(result));
+    assert.match(await page.locator('#status').innerText(),new RegExp(`Saved: Updated ${kind} trusted=true`));
+    // Exact duplicate returns receipt, never a second input dispatch.
+    assert.deepEqual(await rpc('act',click),result);
+    assert.equal(await page.evaluate(()=>window.saveCount),1);
+    await page.reload();
+    assert.equal(await page.locator('input,[contenteditable]').evaluate(e=>e.value??e.textContent),`Updated ${kind}`);
+    const stale=await rpc('act',{...action,id:`stale-${kind}`});assert.match(stale.error,/STALE_/);
+  }
+  // Execute the actual provider-neutral module, not a bridge-only mock.
+  await page.goto(`${base}/notion`);
+  const python = `import sys,json
+from pathlib import Path
+from providers.runtime import ProviderTask
+from modules import browser_extension_transport as transport
+from modules.browser_adapter import execute_browser_module,BrowserAdapterError
+transport.CONNECTION=Path(sys.argv[1])
+context={"browser":{"transport":"extension","authorized_origins":[sys.argv[2]],"allow_external_mutation":True,"expect_text":"Saved: Module verified","actions":[{"action":"fill","role":"textbox","name":"Page content","text":"Module verified"},{"action":"click","role":"button","name":"Save"}]}}
+try:
+ execute_browser_module(ProviderTask(workspace=Path.cwd(),objective="deny writes",context=context))
+ raise AssertionError("READ_ONLY allowed mutation")
+except BrowserAdapterError as error:
+ assert "WORKSPACE_WRITE" in str(error)
+result=execute_browser_module(ProviderTask(workspace=Path.cwd(),objective="fixture edit",context=context,execution_policy="WORKSPACE_WRITE"))
+assert result["domain_outcome"]=="BROWSER_VERIFIED"
+assert len(result["evidence"])==2
+context["browser"]={"transport":"extension","authorized_origins":["https://unauthorized.example"]}
+try:
+ execute_browser_module(ProviderTask(workspace=Path.cwd(),objective="deny origin",context=context))
+ raise AssertionError("wrong origin accepted")
+except BrowserAdapterError as error:
+ assert "outside authorized_origins" in str(error)
+print(json.dumps({"module":"PASS","read_only":"DENIED","wrong_origin":"DENIED","evidence":result["evidence"]}))`;
+  const integration=await promisify(execFile)('python3',['-c',python,path.join(directory,'bridge/connection.json'),base],{cwd:root,env:{...process.env,PYTHONPATH:`${workbench}/agent-brain`}});
+  assert.equal(JSON.parse(integration.stdout).module,'PASS');
+  assert.match(await page.locator('#status').innerText(),/Saved: Module verified trusted=true/);
+  // Bounded bulk workflow: three independent rows, persisted by distinct targets.
+  await page.goto(`${base}/bulk`);
+  await page.evaluate(()=> {
+    document.body.innerHTML='<h1>Bulk editor</h1><p id="status"></p>';
+    for(let i=0;i<3;i++) {
+      const input=document.createElement('input');input.setAttribute('aria-label',`Item ${i}`);document.body.append(input);
+      const button=document.createElement('button');button.textContent=`Save ${i}`;
+      button.onclick=e=>{localStorage.setItem(`item-${i}`,input.value);document.querySelector('#status').textContent=`Saved item ${i}: ${input.value}; trusted=${e.isTrusted}`;};document.body.append(button);
+    }
+  });
+  const batchPython=`import sys,json\nfrom pathlib import Path\nfrom providers.runtime import ProviderTask\nfrom modules import browser_extension_transport as transport\nfrom modules.browser_adapter import execute_browser_module\ntransport.CONNECTION=Path(sys.argv[1])\nactions=[]\nfor i in range(3):\n actions.extend([{"action":"fill","role":"textbox","name":f"Item {i}","text":f"Batch {i}"},{"action":"click","role":"button","name":f"Save {i}"}])\nresult=execute_browser_module(ProviderTask(workspace=Path.cwd(),objective="batch fixture",execution_policy="WORKSPACE_WRITE",context={"browser":{"transport":"extension","actions":actions,"authorized_origins":[sys.argv[2]],"allow_external_mutation":True,"expect_text":"Saved item 2: Batch 2; trusted=true"}}))\nassert len(result["evidence"])==6\nprint(json.dumps({"batch":"PASS"}))`;
+  const batch=await promisify(execFile)('python3',['-c',batchPython,path.join(directory,'bridge/connection.json'),base],{cwd:root,env:{...process.env,PYTHONPATH:`${workbench}/agent-brain`}});
+  assert.equal(JSON.parse(batch.stdout).batch,'PASS');
+  assert.deepEqual(await page.evaluate(()=>[0,1,2].map(i=>localStorage.getItem(`item-${i}`))),['Batch 0','Batch 1','Batch 2']);
+  // Chromium AX observes closed shadow roots; native input reaches the textbox.
+  await page.goto(`${base}/shadow`);
+  await page.evaluate(()=> {
+    document.body.innerHTML='<h1>Closed shadow</h1><section></section><p id="status"></p>';
+    const root=document.querySelector('section').attachShadow({mode:'closed'});
+    root.innerHTML='<input aria-label="Shadow title"><button>Save shadow</button>';
+    root.querySelector('button').onclick=e=>{document.querySelector('#status').textContent=`Shadow saved: ${root.querySelector('input').value}; trusted=${e.isTrusted}`;};
+  });
+  let shadow=await rpc('observe');
+  let target=shadow.elements.find(e=>e.name==='Shadow title');assert.ok(target);
+  assert.equal((await rpc('act',{ref:target.ref,lease:shadow.lease,epoch:shadow.epoch,pageId:shadow.pageId,action:'fill',text:'Closed root'})).status,'COMPLETED');
+  shadow=await rpc('observe');target=shadow.elements.find(e=>e.name==='Save shadow');
+  assert.equal((await rpc('act',{ref:target.ref,lease:shadow.lease,epoch:shadow.epoch,pageId:shadow.pageId,action:'click'})).status,'COMPLETED');
+  assert.equal(await page.locator('#status').innerText(),'Shadow saved: Closed root; trusted=true');
+  // Unnamed rich contenteditable blocks are common in Notion-like editors.
+  await page.goto(`${base}/rich-editor`);
+  await page.evaluate(()=>{document.body.innerHTML='<h1>Rich editor</h1><div contenteditable="true">Old block</div>';});
+  const rich=await rpc('observe');const block=rich.elements.find(e=>e.role==='textbox');assert.ok(block,JSON.stringify(rich));
+  assert.equal((await rpc('act',{ref:block.ref,lease:rich.lease,epoch:rich.epoch,pageId:rich.pageId,action:'fill',text:'New block'})).status,'COMPLETED');
+  assert.equal(await page.locator('[contenteditable]').innerText(),'New block');
+  // An overlay must never redirect a click to a different control.
+  await page.goto(`${base}/generic`);
+  const covered=await rpc('observe');
+  await page.evaluate(()=>{const cover=document.createElement('div');cover.style='position:fixed;inset:0;background:white;z-index:99999';document.body.append(cover);});
+  assert.equal((await rpc('act',{ref:covered.elements.find(e=>e.name==='Save').ref,lease:covered.lease,epoch:covered.epoch,pageId:covered.pageId,action:'click'})).error,'OCCLUDED_TARGET');
+  for(const [kind,code] of [['auth','BLOCKED_AUTH'],['challenge','BLOCKED_CHALLENGE'],['payment','BLOCKED_PAYMENT']]) {
+    await page.goto(`${base}/${kind}`);assert.equal((await rpc('observe')).error,code);
+  }
+  await page.goto(`${base}/generic`);
+  const observed=await rpc('observe');
+  await page.evaluate(()=>history.pushState({},'', '/other'));
+  const stale=await rpc('act',{ref:observed.elements.find(e=>e.name==='Save').ref,lease:observed.lease,epoch:observed.epoch,pageId:observed.pageId,action:'click'});
+  assert.match(stale.error,/STALE_/);
+  await page.goto('data:text/html,other-origin');
+  assert.equal((await rpc('observe')).error,'BLOCKED_POLICY');
+  assert.equal((await rpc('handoff')).status,'COMPLETED');
+  assert.equal((await rpc('observe')).error,'NOT_PAIRED');
+});
