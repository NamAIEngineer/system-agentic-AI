diff --git a/cli/bridge.mjs b/cli/bridge.mjs
new file mode 100644
--- /dev/null
+++ b/cli/bridge.mjs
@@ -0,0 +1,126 @@
+import http from 'node:http';
+import fs from 'node:fs';
+import path from 'node:path';
+import {randomBytes, timingSafeEqual, createHash} from 'node:crypto';
+import {WebSocketServer} from 'ws';
+import {validate} from '../shared/protocol.mjs';
+
+// Local controller and extension tokens are distinct. Nothing is sent off-machine.
+export async function startBridge({directory, extensionId, port = 0, timeout = 15000}) {
+  if (!/^[a-p]{32}$/.test(extensionId)) throw Error('extensionId required');
+  fs.mkdirSync(directory, {recursive:true, mode:0o700});
+  fs.chmodSync(directory, 0o700);
+  const lockFile=path.join(directory,'bridge.lock');
+  const lock=fs.openSync(lockFile,'wx',0o600);
+  fs.writeFileSync(lock,String(process.pid)); fs.closeSync(lock);
+  const token = () => randomBytes(32).toString('hex');
+  const config = {controllerToken:token(), extensionToken:token(), extensionId};
+  const receiptFile = path.join(directory, 'receipts.json');
+  let receipts = fs.existsSync(receiptFile) ? JSON.parse(fs.readFileSync(receiptFile)) : {};
+  for (const receipt of Object.values(receipts))
+    if (receipt.result?.status === 'PENDING') receipt.result = {status:'UNCERTAIN', error:'BRIDGE_RESTARTED'};
+  const persist = () => {
+    const temporary = receiptFile + '.tmp';
+    fs.writeFileSync(temporary, JSON.stringify(receipts), {mode:0o600});
+    fs.renameSync(temporary, receiptFile);
+  };
+  persist();
+  const same = (a,b) => {
+    if(typeof a !== 'string') return false;
+    const left=Buffer.from(a),right=Buffer.from(b);
+    return left.length===right.length && timingSafeEqual(left,right);
+  };
+  let extension = null;
+  const pending = new Map();
+  const answer = (response, status, body) => {
+    response.writeHead(status, {'Content-Type':'application/json', 'Cache-Control':'no-store'});
+    response.end(JSON.stringify(body));
+  };
+  const server = http.createServer(async (request, response) => {
+    if (request.headers.origin || !/^127\.0\.0\.1:\d+$/.test(request.headers.host || '') ||
+        !same(request.headers.authorization, `Bearer ${config.controllerToken}`))
+      return answer(response,403,{error:'FORBIDDEN'});
+    if (request.method === 'GET' && request.url === '/health')
+      return answer(response,200,{status:extension ? 'PAIRED' : 'NOT_PAIRED'});
+    if (request.method === 'GET' && /^\/receipts\/[a-zA-Z0-9_-]{1,100}$/.test(request.url || '')) {
+      const id=request.url.split('/').pop();
+      return answer(response,200,Object.hasOwn(receipts,id) ? receipts[id].result : {status:'NOT_FOUND'});
+    }
+    if (request.method !== 'POST' || request.url !== '/rpc') return answer(response,404,{error:'NOT_FOUND'});
+    try {
+      let data = '';
+      for await (const chunk of request) {
+        data += chunk;
+        if (Buffer.byteLength(data)>20000) throw Error('REQUEST_TOO_LARGE');
+      }
+      const rpc = validate(JSON.parse(data));
+      const digest = createHash('sha256').update(JSON.stringify(rpc)).digest('hex');
+      if (receipts[rpc.id]) {
+        if (receipts[rpc.id].digest !== digest) throw Error('REQUEST_ID_CONFLICT');
+        return answer(response,200,receipts[rpc.id].result);
+      }
+      if (!extension) return answer(response,409,{status:'FAILED',error:'NOT_PAIRED'});
+      // Bound session journal. Never evict uncertainty and thereby permit a replay.
+      if (Object.keys(receipts).length >= 5000) throw Error('SESSION_CAPACITY_REACHED');
+      receipts[rpc.id] = {digest, result:{status:'PENDING'}};
+      persist();
+      const finish = result => {
+        if (!pending.has(rpc.id)) return;
+        clearTimeout(pending.get(rpc.id).timer);
+        pending.delete(rpc.id);
+        receipts[rpc.id].result = result;
+        persist();
+        answer(response,200,result);
+      };
+      const timer = setTimeout(() => finish({status:'UNCERTAIN',error:'TIMEOUT',id:rpc.id}),timeout);
+      pending.set(rpc.id,{timer,finish});
+      extension.send(JSON.stringify({...rpc, deadline:Date.now()+timeout-100}));
+    } catch (error) { answer(response,400,{status:'FAILED',error:error.message}); }
+  });
+  server.requestTimeout = 5000;
+  server.headersTimeout = 5000;
+  const wss = new WebSocketServer({noServer:true,maxPayload:256000});
+  server.on('upgrade', (request,socket,head) => {
+    if (request.url !== '/extension' || request.headers.origin !== `chrome-extension://${extensionId}` ||
+        !/^127\.0\.0\.1:\d+$/.test(request.headers.host || '')) return socket.destroy();
+    wss.handleUpgrade(request,socket,head,ws => {
+      const authTimer = setTimeout(()=>ws.close(1008),2000);
+      let authenticated = false;
+      ws.on('message', buffer => {
+        try {
+          const message = JSON.parse(buffer.toString());
+          if (!authenticated) {
+            if (!same(message.token,config.extensionToken) || extension) return ws.close(1008);
+            authenticated = true; extension = ws; clearTimeout(authTimer);
+            ws.send(JSON.stringify({type:'ready'})); return;
+          }
+          if (message.type === 'heartbeat') return ws.send(JSON.stringify({type:'heartbeat'}));
+          if (typeof message.id === 'string') pending.get(message.id)?.finish(message);
+        } catch { ws.close(1008); }
+      });
+      ws.on('close',()=> {
+        clearTimeout(authTimer);
+        if (extension === ws) {
+          extension = null;
+          for (const [id,item] of pending) item.finish({id,status:'UNCERTAIN',error:'EXTENSION_DISCONNECTED'});
+        }
+      });
+      ws.on('error',()=>{});
+    });
+  });
+  await new Promise(resolve => server.listen(port,'127.0.0.1',resolve));
+  config.port = server.address().port;
+  fs.writeFileSync(path.join(directory,'connection.json'),JSON.stringify(config),{mode:0o600});
+  return {config, close:async()=> {
+    for (const client of wss.clients) client.terminate();
+    await new Promise(resolve=>server.close(resolve)); wss.close();
+    fs.unlinkSync(lockFile);
+  }};
+}
+if (process.argv[1] === new URL(import.meta.url).pathname) {
+  const [directory,extensionId] = process.argv.slice(2);
+  if (!directory) throw Error('usage: node cli/bridge.mjs PRIVATE_SESSION_DIRECTORY EXTENSION_ID');
+  const bridge = await startBridge({directory,extensionId});
+  for(const signal of ['SIGTERM','SIGINT']) process.once(signal,async()=>{await bridge.close();process.exit(0);});
+  console.log(JSON.stringify({status:'LISTENING',port:bridge.config.port,connectionFile:path.join(directory,'connection.json')}));
+}
diff --git a/extension/background.mjs b/extension/background.mjs
new file mode 100644
--- /dev/null
+++ b/extension/background.mjs
@@ -0,0 +1,113 @@
+import {validate, capabilities} from './shared/protocol.mjs';
+import {command,pageIdentity,snapshot,act} from './cdp.mjs';
+let socket, connectionKey;
+let queue = Promise.resolve();
+const serialized = fn => { const result=queue.then(fn); queue=result.catch(()=>{}); return result; };
+const state = async () => (await chrome.storage.session.get('pair')).pair;
+async function invalidate(tabId) {
+  const pair=await state();
+  if (pair?.tabId === tabId) await chrome.storage.session.set({pair:{...pair,epoch:pair.epoch+1,refs:{}}});
+}
+// Mark navigation synchronously, before the serialized persistence work. A
+// navigation occurring during an in-flight command must fence that command too.
+const invalidating=new Map();
+function navigation(tabId) {
+  const marker=Symbol(); invalidating.set(tabId,marker);
+  serialized(async()=> {
+    await invalidate(tabId);
+    if(invalidating.get(tabId)===marker) invalidating.delete(tabId);
+  });
+}
+chrome.webNavigation.onCommitted.addListener(e=> { if(e.frameId===0) navigation(e.tabId); });
+chrome.webNavigation.onHistoryStateUpdated.addListener(e=> { if(e.frameId===0) navigation(e.tabId); });
+chrome.debugger.onDetach.addListener(({tabId})=>navigation(tabId));
+async function fresh(pair,request) {
+  if(invalidating.has(pair.tabId)) throw Error('STALE_FENCE');
+  const current=await state();
+  if(request && Date.now()>=request.deadline) throw Error('BLOCKED_POLICY_EXPIRED');
+  const identity=await pageIdentity(pair.tabId);
+  if (!current || current.lease!==pair.lease || new URL(identity.url).origin!==pair.origin) throw Error('BLOCKED_POLICY');
+  if (request && (request.lease!==current.lease || request.epoch!==current.epoch || request.pageId!==identity.pageId)) throw Error('STALE_FENCE');
+  return identity;
+}
+async function execute(rpc) {
+  validate(rpc);
+  if(!Number.isFinite(rpc.deadline) || Date.now()>=rpc.deadline) throw Error('BLOCKED_POLICY_EXPIRED');
+  if(rpc.op==='capabilities') return {status:'COMPLETED',capabilities,paired:Boolean(await state())};
+  const pair=await state();
+  if(!pair) throw Error('NOT_PAIRED');
+  if(rpc.op==='handoff') {
+    await chrome.storage.session.remove('pair');
+    try {await chrome.debugger.detach({tabId:pair.tabId});} catch {}
+    return {status:'COMPLETED',handoff:true};
+  }
+  const identity=await fresh(pair,rpc.op==='act' ? rpc : null);
+  if(rpc.op==='act') {
+    const ref=pair.refs[rpc.ref];
+    if(!ref || pair.pageId!==identity.pageId) throw Error('STALE_REF');
+    return act(pair.tabId,rpc,ref,()=>fresh(pair,rpc));
+  }
+  const observed=await snapshot(pair.tabId);
+  const after=await fresh(pair);
+  if(after.pageId!==identity.pageId) throw Error('STALE_FENCE');
+  await chrome.storage.session.set({pair:{...pair,...identity,refs:observed.refs}});
+  const {refs,...data}=observed;
+  const host=new URL(identity.url).hostname;
+  return {status:'COMPLETED',...identity,...data,lease:pair.lease,epoch:pair.epoch,
+    profile:host==='github.com' ? 'github' : /(^|\.)notion\.(so|site|com)$/.test(host) ? 'notion' : 'generic'};
+}
+async function handle(rpc) {
+  const {journal={}}=await chrome.storage.session.get('journal');
+  const digest=JSON.stringify(rpc);
+  if(journal[rpc.id]) return journal[rpc.id].digest===digest ? journal[rpc.id].result : {status:'FAILED',error:'REQUEST_ID_CONFLICT'};
+  if(Object.keys(journal).length>=5000) return {status:'FAILED',error:'SESSION_CAPACITY_REACHED'};
+  journal[rpc.id]={digest,result:{id:rpc.id,status:'UNCERTAIN',error:'INTERRUPTED'}};
+  await chrome.storage.session.set({journal});
+  let result;
+  try {result={id:rpc.id,...await execute(rpc)};}
+  catch(error) {result={id:rpc.id,status:rpc.op==='act' && !/^(STALE_|BLOCKED_|UNSUPPORTED|OCCLUDED|INVALID|NOT_PAIRED)/.test(error.message) ? 'UNCERTAIN' : 'FAILED',error:error.message};}
+  journal[rpc.id].result=result;
+  await chrome.storage.session.set({journal});
+  return result;
+}
+function connect(config) {
+  const key=`${config.port}:${config.token}`;
+  if(socket?.readyState===1 && connectionKey===key) return;
+  if(socket) socket.close();
+  connectionKey=key;
+  socket=new WebSocket(`ws://127.0.0.1:${config.port}/extension`);
+  const own=socket;
+  own.onopen=()=>own.send(JSON.stringify({token:config.token}));
+  own.onmessage=e=> {
+    const message=JSON.parse(e.data);
+    if(message.type) return;
+    serialized(()=>handle(message)).then(result=> {if(own.readyState===1) own.send(JSON.stringify(result));});
+  };
+  const heartbeat=setInterval(()=> {if(own.readyState===1) own.send(JSON.stringify({type:'heartbeat'}));},20000);
+  own.onclose=()=>clearInterval(heartbeat);
+}
+chrome.runtime.onMessage.addListener((message,sender,reply)=> {
+  if(sender.id!==chrome.runtime.id || sender.url!==chrome.runtime.getURL('pair.html')) return;
+  if(message.type==='pair') {
+    serialized(async()=> {
+      if(!Number.isInteger(message.port) || message.port<1 || message.port>65535 || !/^[a-f0-9]{64}$/.test(message.token)) throw Error('INVALID_PAIRING');
+      const tab=await chrome.tabs.get(Number(message.tabId));
+      const url=new URL(tab.url);
+      if(!['http:','https:'].includes(url.protocol)) throw Error('BLOCKED_POLICY');
+      const previous=await state();
+      if(previous) {try{await chrome.debugger.detach({tabId:previous.tabId});}catch{}}
+      await chrome.debugger.attach({tabId:tab.id},'1.3');
+      await command(tab.id,'Page.enable');
+      const identity=await pageIdentity(tab.id);
+      if(new URL(identity.url).origin!==url.origin) throw Error('STALE_FENCE');
+      await chrome.storage.session.set({pair:{tabId:tab.id,origin:url.origin,lease:crypto.randomUUID(),epoch:(previous?.epoch || 0)+1,...identity,refs:{}}});
+      connect(message);
+      return {status:'PAIRED',origin:url.origin};
+    }).then(reply,error=>reply({status:'FAILED',error:error.message}));
+    return true;
+  }
+  if(message.type==='revoke') {
+    serialized(()=>execute({version:1,id:crypto.randomUUID(),op:'handoff'})).then(reply,error=>reply({status:'FAILED',error:error.message}));
+    return true;
+  }
+});
diff --git a/extension/cdp.mjs b/extension/cdp.mjs
new file mode 100644
--- /dev/null
+++ b/extension/cdp.mjs
@@ -0,0 +1,74 @@
+export const command = (tabId,method,params={}) => chrome.debugger.sendCommand({tabId},method,params);
+export async function pageIdentity(tabId) {
+  const {frameTree} = await command(tabId,'Page.getFrameTree');
+  const frame = frameTree.frame;
+  return {pageId:`${frame.id}:${frame.loaderId}:${frame.url}`,url:frame.url,frameId:frame.id};
+}
+export async function tree(tabId) {
+  const {nodes} = await command(tabId,'Accessibility.getFullAXTree');
+  const visible = nodes.filter(n=>!n.ignored);
+  const headings = visible.filter(n=>['heading','RootWebArea'].includes(n.role?.value)).map(n=>n.name?.value || '').join('\n');
+  if (/captcha|verify (you are|your identity)|checking your browser|security challenge/i.test(headings)) throw Error('BLOCKED_CHALLENGE');
+  if (/sign in to continue|log in to continue|two.factor|verification code/i.test(headings) ||
+      visible.some(n=>n.properties?.some(p=>p.name === 'protected' && p.value?.value))) throw Error('BLOCKED_AUTH');
+  if (/checkout|payment required|complete your purchase|subscribe to continue/i.test(headings)) throw Error('BLOCKED_PAYMENT');
+  return visible;
+}
+const editable = n => n.properties?.some(p=>p.name==='editable' && ['plain','richtext',true].includes(p.value?.value));
+const roles = new Set(['button','link','textbox','checkbox','combobox','menuitem','tab','searchbox']);
+export async function snapshot(tabId) {
+  const nodes = await tree(tabId);
+  const refs = {};
+  const candidates = nodes.filter(n=>(roles.has(n.role?.value) || editable(n)) && n.backendDOMNodeId);
+  const elements = candidates.slice(0,200).map((n,index)=> {
+    const ref = crypto.randomUUID();
+    refs[ref] = {backendNodeId:n.backendDOMNodeId,role:n.role.value,name:n.name?.value || '',editable:Boolean(editable(n))};
+    return {ref,role:editable(n) ? 'textbox' : n.role.value,name:(n.name?.value || `Editable block ${index+1}`).slice(0,200),disabled:n.properties?.some(p=>p.name==='disabled' && p.value?.value) || false};
+  });
+  const text=nodes.filter(n=>['heading','StaticText'].includes(n.role?.value)).map(n=>n.name?.value || '').join('\n');
+  return {refs,elements,text:text.slice(0,12000),truncated:{elements:candidates.length>200,text:text.length>12000},title:nodes.find(n=>n.role?.value==='RootWebArea')?.name?.value || ''};
+}
+export async function act(tabId,request,ref,check) {
+  const nodes = await tree(tabId);
+  const current = nodes.find(n=>n.backendDOMNodeId===ref.backendNodeId);
+  if (!current || current.role?.value !== ref.role || (current.name?.value || '') !== ref.name) throw Error('STALE_REF');
+  if (current.properties?.some(p=>['disabled','readonly'].includes(p.name) && p.value?.value)) throw Error('BLOCKED_POLICY');
+  const {node} = await command(tabId,'DOM.describeNode',{backendNodeId:ref.backendNodeId});
+  const attrs = Object.fromEntries(Array.from({length:(node.attributes?.length || 0)/2},(_,i)=>node.attributes.slice(i*2,i*2+2)));
+  if (/^(sign in|log in|login|verify|pay|purchase|checkout|subscribe)(\b|$)/i.test(ref.name)) throw Error('BLOCKED_POLICY');
+  if (attrs.type === 'password') throw Error('BLOCKED_AUTH');
+  if (attrs.type === 'file') throw Error('BLOCKED_POLICY');
+  // Fixed native commands only; no controller-supplied script or DOM-click fallback.
+  if (request.action === 'fill') {
+    if (!['textbox','searchbox'].includes(ref.role) && !ref.editable) throw Error('UNSUPPORTED');
+    await command(tabId,'DOM.focus',{backendNodeId:ref.backendNodeId});
+    await check();
+    await command(tabId,'Input.dispatchKeyEvent',{type:'keyDown',key:'a',code:'KeyA',modifiers: navigator.platform.includes('Mac') ? 4 : 2,commands:['selectAll']});
+    await command(tabId,'Input.dispatchKeyEvent',{type:'keyUp',key:'a',code:'KeyA'});
+    await check();
+    await command(tabId,'Input.insertText',{text:request.text});
+  } else {
+    await command(tabId,'DOM.scrollIntoViewIfNeeded',{backendNodeId:ref.backendNodeId});
+    const {model} = await command(tabId,'DOM.getBoxModel',{backendNodeId:ref.backendNodeId});
+    const x=(model.content[0]+model.content[4])/2, y=(model.content[1]+model.content[5])/2;
+    const hit = await command(tabId,'DOM.getNodeForLocation',{x:Math.round(x),y:Math.round(y),includeUserAgentShadowDOM:true});
+    if (hit.backendNodeId !== ref.backendNodeId) {
+      const target = await command(tabId,'DOM.resolveNode',{backendNodeId:ref.backendNodeId});
+      const located = await command(tabId,'DOM.resolveNode',{backendNodeId:hit.backendNodeId});
+      try {
+        const result = await command(tabId,'Runtime.callFunctionOn',{
+          objectId:target.object.objectId,
+          functionDeclaration:'function(hit){for(let i=0;hit&&i<100;i++){if(hit===this)return true;hit=hit.parentNode||hit.host;}return false;}',
+          arguments:[{objectId:located.object.objectId}],returnByValue:true});
+        if(result.result.value!==true) throw Error('OCCLUDED_TARGET');
+      } finally {
+        await command(tabId,'Runtime.releaseObject',{objectId:target.object.objectId});
+        await command(tabId,'Runtime.releaseObject',{objectId:located.object.objectId});
+      }
+    }
+    await check();
+    await command(tabId,'Input.dispatchMouseEvent',{type:'mousePressed',x,y,button:'left',clickCount:1});
+    await command(tabId,'Input.dispatchMouseEvent',{type:'mouseReleased',x,y,button:'left',clickCount:1});
+  }
+  return {status:'COMPLETED',action:request.action};
+}
