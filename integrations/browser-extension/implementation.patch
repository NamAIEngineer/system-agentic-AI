diff --git a/extension/pair.mjs b/extension/pair.mjs
new file mode 100644
--- /dev/null
+++ b/extension/pair.mjs
@@ -0,0 +1,25 @@
+const element=id=>document.getElementById(id);
+for(const tab of await chrome.tabs.query({})) {
+  if(!/^https?:/.test(tab.url || '')) continue;
+  const option=document.createElement('option'); option.value=tab.id; option.textContent=`${tab.title} — ${new URL(tab.url).origin}`;
+  element('tab').append(option);
+}
+element('pair').onsubmit=async event=> {
+  event.preventDefault();
+  const result=await chrome.runtime.sendMessage({type:'pair',tabId:Number(element('tab').value),port:Number(element('port').value),token:element('token').value});
+  element('token').value=''; element('result').textContent=JSON.stringify(result);
+};
+element('revoke').onclick=async()=> {element('result').textContent=JSON.stringify(await chrome.runtime.sendMessage({type:'revoke'}));};
+
+element('connection').onchange=async event=> {
+  try {
+    const file=event.target.files[0];
+    if(!file || file.size>4096) throw Error('Invalid connection file');
+    const config=JSON.parse(await file.text());
+    if(config.extensionId!==chrome.runtime.id) throw Error('Connection belongs to another extension');
+    element('port').value=config.port;
+    element('token').value=config.extensionToken;
+    element('result').textContent='Connection loaded. Review the selected tab before pairing.';
+  } catch(error) {element('result').textContent=error.message;}
+  event.target.value='';
+};
